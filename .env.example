# Email delivery via Resend (https://resend.com)
# Without RESEND_API_KEY, contact/meeting requests fall back to mailto: drafts
# so nothing is lost while the integration is pending.
RESEND_API_KEY=

# Inbox that receives contact form + meeting requests
CONTACT_EMAIL=

# Sender identity — onboarding@resend.dev works until a custom domain is
# verified in the Resend dashboard
MAIL_FROM="SpaceNet <onboarding@resend.dev>"
